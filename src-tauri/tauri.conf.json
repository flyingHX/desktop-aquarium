{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-aquarium",
  "version": "1.0.8",
  "identifier": "com.desktop.aquarium",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png"
    ]
  }
}
